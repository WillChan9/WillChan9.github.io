    <item>
      <title>Pulse Power Supply Development</title>
      <link>http://localhost:1313/project/pulse-power/</link>
      <pubDate>Sat, 01 Aug 2020 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/project/pulse-power/</guid>
      <description>&lt;style&gt;
  .btn-link {
    display: inline-block;
    background-color: #4da6ff; /* Light blue */
    color: white !important; /* Ensures white text */
    font-size: 1em;
